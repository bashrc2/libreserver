function install_reticulum {
    increment_app_install_progress

    if [ -d "/var/www/$RETICULUM_DOMAIN_NAME/htdocs" ]; then
        rm -rf "/var/www/$RETICULUM_DOMAIN_NAME/htdocs"
    fi
    mkdir -p "/var/www/$RETICULUM_DOMAIN_NAME/htdocs"
    mkdir "/etc/reticulum"
    cd "/etc/reticulum" || exit 34

    chmod g+w "/var/www/$RETICULUM_DOMAIN_NAME/htdocs"
    chown -R www-data:www-data "/var/www/$RETICULUM_DOMAIN_NAME/htdocs"

    increment_app_install_progress

    INSTALL_PACKAGES python3-pip python3-virtualenv

    increment_app_install_progress

    { echo '#!/bin/bash';
      echo "cd /etc/reticulum || exit 1";
      echo 'virtualenv -p python3 .venv';
      echo 'source .venv/bin/activate';
      echo "pip3 install -U rns";
      echo 'deactivate'; } > ${reticulum_upgrade_filename}
    chmod +x ${reticulum_upgrade_filename}
    /bin/bash ${reticulum_upgrade_filename}

    increment_app_install_progress

    adduser --system --home="/etc/reticulum" --group reticulum

    create_reticulum_config /etc/reticulum/config

    increment_app_install_progress

    { echo '[Unit]';
      echo 'Description=reticulum';
      echo 'After=network.target';
      echo "Documentation=https://reticulum.miraheze.org/wiki";
      echo '';
      echo '[Service]';
      echo 'Type=simple';
      echo 'User=reticulum';
      echo 'Group=reticulum';
      echo 'WorkingDirectory=/etc/reticulum';
      echo "ExecStart=/etc/reticulum/.venv/bin/python3 .venv/bin/rnsd -v -s";
      echo 'Environment=USER=reticulum';
      echo 'Restart=always';
      echo 'ProtectHome=true';
      echo 'ProtectKernelTunables=true';
      echo 'ProtectKernelModules=true';
      echo 'ProtectControlGroups=true';
      echo 'ProtectKernelLogs=true';
      echo 'ProtectHostname=true';
      echo 'ProtectClock=true';
      echo 'ProtectProc=invisible';
      echo 'ProcSubset=pid';
      echo 'PrivateTmp=true';
      echo 'PrivateUsers=true';
      echo 'PrivateDevices=true';
      echo 'PrivateIPC=true';
      echo 'MemoryDenyWriteExecute=true';
      echo 'NoNewPrivileges=true';
      echo 'LockPersonality=true';
      echo 'RestrictRealtime=true';
      echo 'RestrictSUIDSGID=true';
      echo 'RestrictAddressFamilies=AF_INET';
      echo 'RestrictNamespaces=true';
      echo 'SystemCallArchitectures=native';
      echo '';
      echo '[Install]';
      echo 'WantedBy=multi-user.target'; } > "/etc/systemd/system/reticulum.service"
    systemctl enable reticulum
    chown -R reticulum:reticulum "/etc/reticulum"
    systemctl start reticulum

    increment_app_install_progress

    "${PROJECT_NAME}-pass" -u "$MY_USERNAME" -a reticulum -p "$RETICULUM_ADMIN_PASSWORD"
    firewall_reticulum

    increment_app_install_progress

    APP_INSTALLED=1
}

