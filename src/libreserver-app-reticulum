function backup_local_reticulum {
    source_directory=/etc/reticulum

    systemctl stop reticulum
    dest_directory=reticulum
    backup_directory_to_usb "$source_directory" $dest_directory
    systemctl start reticulum
}

function restore_local_reticulum {
    systemctl stop reticulum

    temp_restore_dir=/root/tempreticulum
    reticulum_dir=/etc/reticulum

    restore_directory_from_usb $temp_restore_dir reticulum
    if [ -d $temp_restore_dir ]; then
        if [ -d "$temp_restore_dir$reticulum_dir" ]; then
            cp -rp "$temp_restore_dir$reticulum_dir"/* "$reticulum_dir"/
        else
            if [ ! -d "$reticulum_dir" ]; then
                mkdir "$reticulum_dir"
            fi
            cp -rp "$temp_restore_dir"/* "$reticulum_dir"/
        fi
        chown -R reticulum:reticulum "$reticulum_dir"
        rm -rf $temp_restore_dir
        restoring_reticulum=1
    fi
    systemctl start reticulum

    restoring_reticulum=
}

