function remove_reticulum {
    if [ -f /etc/systemd/system/reticulum.service ]; then
        systemctl stop reticulum
        systemctl disable reticulum
        rm /etc/systemd/system/reticulum.service
    fi
    userdel -r reticulum

    if [ -f ${reticulum_upgrade_filename} ]; then
        rm ${reticulum_upgrade_filename}
    fi

    if [ -d "/var/www/$RETICULUM_DOMAIN_NAME" ]; then
        rm -rf "/var/www/$RETICULUM_DOMAIN_NAME"
    fi
    remove_app reticulum
    remove_completion_param install_reticulum
    sed -i '/reticulum/d' "$COMPLETION_FILE"
}

