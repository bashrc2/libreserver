function configure_interactive_reticulum {
    W=(1 $"Add a peer"
       2 $"Remove a peer")

    while true
    do
        # shellcheck disable=SC2068
        selection=$(dialog --backtitle $"LibreServer Administrator Control Panel" --title $"reticulum" --menu $"Choose an operation, or ESC for main menu:" 14 70 3 "${W[@]}" 3>&2 2>&1 1>&3)

        if [ ! "$selection" ]; then
           break
        fi
        case $selection in
            1) # Add a peer
               ;;
            2) # remove a peer
               ;;
        esac
    done
}

