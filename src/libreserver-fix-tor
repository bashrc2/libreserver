#!/bin/bash

# Used to fix the tor daemon if it breaks

{ echo '[Unit]';
  echo 'Description=Anonymizing overlay network for TCP (multi-instance-master)';
  echo 'After=network-online.target nss-lookup.target';
  echo 'PartOf=tor.service';
  echo 'ReloadPropagatedFrom=tor.service';
  echo '';
  echo '[Service]';
  echo 'Type=simple';
  echo 'User=root';
  echo 'Group=debian-tor';
  echo 'ExecStart=/usr/bin/tor --defaults-torrc /usr/share/tor/tor-service-defaults-torrc -f /etc/tor/torrc --RunAsDaemon 0';

  echo 'NotifyAccess=all';
  echo 'PIDFile=/run/tor.pid';
  echo 'PermissionsStartOnly=yes';
  echo 'ExecReload=/bin/kill -HUP ${MAINPID}';
  echo 'KillSignal=SIGINT';
  echo 'TimeoutStartSec=300';
  echo 'TimeoutStopSec=60';
  echo 'Restart=on-failure';
  echo 'LimitNOFILE=65536';
  echo 'MemoryMax=20%';
  echo 'CPUQuota=30%';
  echo '';
  echo '# Hardening';
  echo 'PrivateTmp=yes';
  echo 'PrivateDevices=yes';
  echo 'ProtectHome=yes';
  echo 'ProtectSystem=full';
  echo 'ReadWriteDirectories=-/run';
  echo 'CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH';
  echo '';
  echo '[Install]';
  echo 'WantedBy=multi-user.target'; } > /lib/systemd/system/tor.service
if ! grep -q "include /etc/torrc.d" /etc/tor/torrc; then
    echo '%include /etc/torrc.d' >> /etc/tor/torrc
fi
if [ ! -d /etc/torrc.d ]; then
    mkdir /etc/torrc.d
fi
chmod -R 644 /etc/torrc.d
rm /etc/torrc.d/*~ &> /dev/null
chmod -R 644 /etc/tor
chown -R debian-tor: /etc/torrc.d
chown -R debian-tor: /etc/tor
chown -R debian-tor: /var/lib/tor
systemctl daemon-reload
systemctl restart tor
