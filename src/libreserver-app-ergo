function upgrade_ergo {
    # has the version number changed?
    CURR_ERGO_VERSION=$(get_completion_param "ergo version")
    if [[ "${CURR_ERGO_VERSION}" == "${ERGO_VERSION}" ]]; then
        if [ ! ${restoring_ergo} ]; then
            return
        fi
    fi

    # choose the appropriate binary tarball
    ARCHITECTURE=$(uname -m)
    ERGO_ARCHITECTURE="${ERGO_ARCH_X86}"
    ERGO_DOWNLOAD=${ERGO_DOWNLOAD_X86}
    if [[ ${ARCHITECTURE} == *"aarch"* ]]; then
        ERGO_DOWNLOAD=${ERGO_DOWNLOAD_ARM64}
        ERGO_ARCHITECTURE="${ERGO_ARCH_ARM64}"
    else
        if [[ ${ARCHITECTURE} == *"arm"* ]]; then
            ERGO_DOWNLOAD=${ERGO_DOWNLOAD_ARM6}
            ERGO_ARCHITECTURE="${ERGO_ARCH_ARMV6}"
        fi
    fi
    
    # download the install tarball
    if [ -f ${INSTALL_DIR}/ergo.tar.gz ]; then
        rm ${INSTALL_DIR}/ergo.tar.gz
    fi
    wget -O ${INSTALL_DIR}/ergo.tar.gz ${ERGO_DOWNLOAD}
    if [ ! -f ${INSTALL_DIR}/ergo.tar.gz ]; then
        echo $"Unable to download ergo tarball ${ERGO_DOWNLOAD}"
        return
    fi
    if [ ! -s ${INSTALL_DIR}/ergo.tar.gz ]; then
        echo $"Unable to download ergo tarball (zero size) ${ERGO_DOWNLOAD}"
        rm ${INSTALL_DIR}/ergo.tar.gz
        return
    fi
    cd ${INSTALL_DIR} || return

    # extract the tarball
    ERGO_EXTRACT_DIRECTORY=${INSTALL_DIR}/ergo-${ERGO_VERSION}-linux-${ERGO_ARCHITECTURE}
    if [ -d ${ERGO_EXTRACT_DIRECTORY} ]; then
        rm -rf ${ERGO_EXTRACT_DIRECTORY}
    fi
    tar -xzf ${INSTALL_DIR}/ergo.tar.gz
    if [ ! -d ${ERGO_EXTRACT_DIRECTORY} ]; then
        echo $"Unable to extract ergo download ${INSTALL_DIR}/ergo.tar.gz"
        return
    fi

    cp -r ${ERGO_EXTRACT_DIRECTORY}/* ${ERGO_DIRECTORY}/
    chmod +x ${ERGO_DIRECTORY}/ergo
    
    set_completion_param "ergo version" "${ERGO_VERSION}"
    chown -R ergo:ergo ${ERGO_DIRECTORY}
    systemctl restart ergo
}

function backup_local_ergo {
    ERGO_DOMAIN_NAME='ergo'
    if grep -q "ergo domain" "$COMPLETION_FILE"; then
        ERGO_DOMAIN_NAME=$(get_completion_param "ergo domain")
    fi

    source_directory=${ERGO_DIRECTORY}

    suspend_site "${ERGO_DOMAIN_NAME}"

    systemctl stop ergo

    dest_directory=ergo
    backup_directory_to_usb "$source_directory" $dest_directory

    restart_site
    systemctl start ergo
}

function restore_local_ergo {
    if ! grep -q "ergo domain" "${COMPLETION_FILE}"; then
        restoring_ergo=
        return
    fi
    ERGO_DOMAIN_NAME=$(get_completion_param "ergo domain")
    if [ ! "${ERGO_DOMAIN_NAME}" ]; then
        return
    fi
    systemctl stop ergo

    temp_restore_dir=/root/tempergo
    ergo_dir=${ERGO_DIRECTORY}

    restore_directory_from_usb ${temp_restore_dir} ergo
    if [ -d ${temp_restore_dir} ]; then
        if [ -d "${temp_restore_dir$ergo_dir}" ]; then
            cp -rp "${temp_restore_dir$ergo_dir}"/* "${ergo_dir}"/
        else
            if [ ! -d "${ergo_dir}" ]; then
                mkdir "${ergo_dir}"
            fi
            cp -rp "${temp_restore_dir}"/* "${ergo_dir}"/
        fi
        chown -R ergo:ergo "${ergo_dir}"
        rm -rf ${temp_restore_dir}
        restoring_ergo=1
    fi
    systemctl start ergo

    restoring_ergo=
}

