function install_ergo_client {
    INSTALL_PACKAGES irssi
    # create configuration files for all accounts
    for d in /home/*/ ; do
        USERNAME=$(echo "$d" | awk -F '/' '{print $3}')
        if [[ $(is_valid_user "${USERNAME}") == "1" ]]; then
            create_ergo_client_config "$USERNAME"
        fi
    done
}

