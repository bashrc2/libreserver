function remove_ergo {
    $REMOVE_PACKAGES irssi

    nginx_dissite "$ERGO_DOMAIN_NAME"
    remove_certs "$ERGO_DOMAIN_NAME"

    if [ -f /etc/systemd/system/ergo.service ]; then
        systemctl stop ergo
        systemctl disable ergo
        rm /etc/systemd/system/ergo.service
    fi
    userdel -r ergo

    if [ -d "/var/www/$ERGO_DOMAIN_NAME" ]; then
        rm -rf "/var/www/$ERGO_DOMAIN_NAME"
    fi
    if [ -f "/etc/nginx/sites-available/$ERGO_DOMAIN_NAME" ]; then
        rm "/etc/nginx/sites-available/$ERGO_DOMAIN_NAME"
    fi
    remove_onion_service ergo "${ERGO_ONION_PORT}"
    if grep -q "ergo" /etc/crontab; then
        sed -i "/ergo/d" /etc/crontab
    fi
    remove_app ergo
    remove_completion_param install_ergo
    sed -i '/ergo/d' "$COMPLETION_FILE"

    firewall_remove 6667 tcp

    remove_ddns_domain "$ERGO_DOMAIN_NAME"
}

function install_ergo {
    increment_app_install_progress

    # choose the appropriate binary tarball
    ARCHITECTURE=$(uname -m)
    ERGO_ARCHITECTURE="${ERGO_ARCH_X86}"
    ERGO_DOWNLOAD=${ERGO_DOWNLOAD_X86}
    if [[ ${ARCHITECTURE} == *"aarch"* ]]; then
        ERGO_DOWNLOAD=${ERGO_DOWNLOAD_ARM64}
        ERGO_ARCHITECTURE="${ERGO_ARCH_ARM64}"
    else
        if [[ ${ARCHITECTURE} == *"arm"* ]]; then
            ERGO_DOWNLOAD=${ERGO_DOWNLOAD_ARM6}
            ERGO_ARCHITECTURE="${ERGO_ARCH_ARMV6}"
        fi
    fi
    if [ ! -d "${INSTALL_DIR}" ]; then
        mkdir -p "${INSTALL_DIR}"
    fi

    increment_app_install_progress
    
    # download the install tarball
    if [ -f ${INSTALL_DIR}/ergo.tar.gz ]; then
        rm ${INSTALL_DIR}/ergo.tar.gz
    fi
    wget -O ${INSTALL_DIR}/ergo.tar.gz ${ERGO_DOWNLOAD}
    if [ ! -f ${INSTALL_DIR}/ergo.tar.gz ]; then
        echo $"Unable to download ergo tarball ${ERGO_DOWNLOAD}"
        exit 39
    fi
    if [ ! -s ${INSTALL_DIR}/ergo.tar.gz ]; then
        echo $"Unable to download ergo tarball (zero size) ${ERGO_DOWNLOAD}"
        rm ${INSTALL_DIR}/ergo.tar.gz
        exit 39
    fi
    cd ${INSTALL_DIR} || exit 87

    increment_app_install_progress

    # extract the tarball
    tar -xzf ${INSTALL_DIR}/ergo.tar.gz
    ERGO_EXTRACT_DIRECTORY=${INSTALL_DIR}/ergo-${ERGO_VERSION}-linux-${ERGO_ARCHITECTURE}
    if [ ! -d ${ERGO_EXTRACT_DIRECTORY} ]; then
        echo $"Unable to extract ergo download ${INSTALL_DIR}/ergo.tar.gz"
        exit 88
    fi

    increment_app_install_progress

    # move the directory
    if [ -f ${ERGO_DIRECTORY} ]; then
        rm -rf ${ERGO_DIRECTORY}
    fi
    mv ${ERGO_EXTRACT_DIRECTORY} ${ERGO_DIRECTORY}
    chmod +x ${ERGO_DIRECTORY}/ergo
    cp ${ERGO_DIRECTORY}/default.yaml ${ERGO_CONFIG}

    increment_app_install_progress

    # get onion address, same as for email
    ERGO_ONION_HOSTNAME=$(cat /var/lib/tor/hidden_service_email/hostname)

    increment_app_install_progress

    # change the configuration file
    sed -i "s|name: ErgoTest|name: LibreServer|g" ${ERGO_CONFIG}
    sed -i "s|name: ergo.test|name: ${DEFAULT_DOMAIN_NAME}|g" ${ERGO_CONFIG}
    sed -i "s|tor-network.onion|${ERGO_ONION_HOSTNAME}|g" ${ERGO_CONFIG}
    sed -i "s|level: .*|level: error|g" ${ERGO_CONFIG}
    echo -n "${DEFAULT_DOMAIN_NAME}" > ${ERGO_DIRECTORY}/domain_name

    increment_app_install_progress

    # generate certificates
    cd ${ERGO_DIRECTORY} || exit 87
    ${ERGO_DIRECTORY}/ergo mkcerts

    increment_app_install_progress

    # create an admin/oper password
    if [ ! "${ERGO_PASSWORD}" ]; then
        if [ -f "${IMAGE_PASSWORD_FILE}" ]; then
            ERGO_PASSWORD="$(printf "%s" "$(cat "$IMAGE_PASSWORD_FILE")")"
        else
            ERGO_PASSWORD="$(create_password "${MINIMUM_PASSWORD_LENGTH}")"
        fi
    fi
    ERGO_PASSWORD_HASHED=$(echo -n "${ERGO_PASSWORD}\n${ERGO_PASSWORD}\n" | ${ERGO_DIRECTORY}/ergo genpasswd)
    if [[ "${ERGO_PASSWORD_HASHED}" != "$"* ]]; then
        echo $"Unable to generate ergo hashed password"
        exit 87
    fi
    sed -i "s|password: \".*|password: \"${ERGO_PASSWORD_HASHED}\"|g" ${ERGO_CONFIG}
    "${PROJECT_NAME}-pass" -u "$MY_USERNAME" -a ergo -p "${ERGO_PASSWORD}"

    increment_app_install_progress

    # create systemd daemon
    adduser --system --home="${ERGO_DIRECTORY}" --group ergo

    { echo '[Unit]';
      echo 'Description=ergo';
      echo 'After=network.target';
      echo "Documentation=${ERGO_REPO}/blob/stable/docs/MANUAL.md";
      echo '';
      echo '[Service]';
      echo 'Type=simple';
      echo 'User=ergo';
      echo 'Group=ergo';
      echo "WorkingDirectory=${ERGO_DIRECTORY}";
      echo 'ExecStart=${ERGO_DIRECTORY}/ergo run';
      echo 'Environment=USER=ergo';
      echo 'Restart=always';
      echo 'ProtectHome=true';
      echo 'ProtectKernelTunables=true';
      echo 'ProtectKernelModules=true';
      echo 'ProtectControlGroups=true';
      echo 'ProtectKernelLogs=true';
      echo 'ProtectHostname=true';
      echo 'ProtectClock=true';
      echo 'ProtectProc=invisible';
      echo 'ProcSubset=pid';
      echo 'PrivateTmp=true';
      echo 'PrivateUsers=true';
      echo 'PrivateDevices=true';
      echo 'PrivateIPC=true';
      echo 'MemoryDenyWriteExecute=true';
      echo 'NoNewPrivileges=true';
      echo 'LockPersonality=true';
      echo 'RestrictRealtime=true';
      echo 'RestrictSUIDSGID=true';
      echo 'RestrictAddressFamilies=AF_INET';
      echo 'RestrictNamespaces=true';
      echo 'SystemCallArchitectures=native';
      echo '';
      echo '[Install]';
      echo 'WantedBy=multi-user.target'; } > "/etc/systemd/system/ergo.service"
    systemctl enable ergo
    chown -R ergo:ergo ${ERGO_DIRECTORY}
    systemctl start ergo

    increment_app_install_progress

    firewall_add ergo ${ERGO_PORT} tcp 5
    firewall_max_connections ${ERGO_PORT} ${ERGO_FIREWALL_MAX_CONNECTIONS}

    increment_app_install_progress

    install_ergo_client

    set_completion_param "ergo version" "${ERGO_VERSION}"

    APP_INSTALLED=1
}

# NOTE: deliberately there is no "exit 0"
