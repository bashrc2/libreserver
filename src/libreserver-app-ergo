function change_default_domain_name_ergo {
    new_default_domain_name="$1"
    # If anything references DEFAULT_DOMAIN_NAME then change it here
    curr_default_domain=$(cat ${ERGO_DIRECTORY}/domain_name)
    sed -i "s|name: ${curr_default_domain}|name: ${new_default_domain_name}|g" ${ERGO_CONFIG}
    chown -R ergo:ergo ${ERGO_DIRECTORY}
    systemctl restart ergo
}

function logging_on_ergo {
    sed -i "s|level: .*|level: debug|g" ${ERGO_CONFIG}
