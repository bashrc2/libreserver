for d in /etc/epicyon/accounts/*/ ; do
    handle=$(echo "$d" | awk -F '/' '{print $5}')
    if [[ "$handle" != *"@"* ]]; then
        continue
    fi
    if [[ "$handle" == "news@"* || "$handle" == "inbox@"* ]]; then
        continue
    fi
    USERNAME=$(echo "$handle" | awk -F '@' '{print $1}')
    if [ ! -d "/etc/epicyon/accounts/$handle/gemini" ]; then
        continue
    fi
    if [ ! -d "/var/gemini/blog/accounts/$USERNAME" ]; then
        mkdir -p "/var/gemini/blog/accounts/$USERNAME"
    fi
    # copy blog files for this account
    cp -r "/etc/epicyon/accounts/$handle/gemini"/* "/var/gemini/blog/accounts/$USERNAME"

    { echo '``` title';
      echo ' ___ ___ _____| |___ ___';
      echo '| . | -_|     | | . | . |';
      echo '|_  |___|_|_|_|_|___|_  |';
      echo '|___|               |___|';
      echo '';
      echo '```'; } > "/var/gemini/blog/accounts/$USERNAME/index.gmi"

    # create an index
    blog_files=$(ls -1 "/var/gemini/blog/accounts/$USERNAME" | sort -r)
    while IFS= read -r line; do
        if [[ "$line" == "index.gmi" ]]; then
            continue
        fi
        description=$(echo "$line" | sed "s|.gmi||g" | sed "s|_| |g" | cut -d' ' -f2-)
        echo "=> $line ${description^}" >> "/var/gemini/blog/accounts/$USERNAME/index.gmi"
    done <<< "$blog_files"
done
